@baseUrl = http://localhost:3001/api
@authorId = 11111111-1111-4111-8111-111111111111
@secondUserId = 22222222-2222-4222-8222-222222222222

### Create a text publication
# @name createPublication
POST {{baseUrl}}/publications
Content-Type: application/json
x-user-id: {{authorId}}

{
  "type": "text",
  "title": "Тестовая публикация Prisma",
  "announcement": "Анонс тестовой публикации должен содержать не менее пятидесяти символов.",
  "text": "Основной текст публикации для проверки сохранения в PostgreSQL.",
  "tags": ["nestjs", "prisma"]
}

### Get the created publication
GET {{baseUrl}}/publications/{{createPublication.response.body.$.id}}

### Update the created publication
PATCH {{baseUrl}}/publications/{{createPublication.response.body.$.id}}
Content-Type: application/json
x-user-id: {{authorId}}

{
  "description": "Публикация обновлена через REST API."
}

### Get published publications
GET {{baseUrl}}/publications?page=1&limit=25&tag=prisma

### Search publications
GET {{baseUrl}}/publications/search?title=Prisma

### Add a comment
# @name createComment
POST {{baseUrl}}/publications/{{createPublication.response.body.$.id}}/comments
Content-Type: application/json
x-user-id: {{secondUserId}}

{
  "text": "Комментарий к тестовой публикации."
}

### Get publication comments
GET {{baseUrl}}/publications/{{createPublication.response.body.$.id}}/comments?page=1

### Like the publication
POST {{baseUrl}}/publications/{{createPublication.response.body.$.id}}/likes
x-user-id: {{secondUserId}}

### Remove the like
DELETE {{baseUrl}}/publications/{{createPublication.response.body.$.id}}/likes
x-user-id: {{secondUserId}}

### Delete the comment
DELETE {{baseUrl}}/publications/{{createPublication.response.body.$.id}}/comments/{{createComment.response.body.$.id}}
x-user-id: {{secondUserId}}

### Delete the publication
DELETE {{baseUrl}}/publications/{{createPublication.response.body.$.id}}
x-user-id: {{authorId}}
