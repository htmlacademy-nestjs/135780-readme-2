PORT=3000
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=readme-account
MONGO_USER=readme-admin
MONGO_PASSWORD=replace-with-password
MONGO_AUTH_SOURCE=admin
JWT_ACCESS_SECRET=replace-with-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
RABBITMQ_URL=amqp://readme:replace-with-password@localhost:5672
RABBITMQ_QUEUE=readme.notifications
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=replace-with-admin-password
