        </mxCell>
        <mxCell id="users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontSize=16;fontColor=#1E3A8A;align=center;spacingLeft=16;arcSize=12;" value="&lt;b&gt;Сервис пользователей&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(30, 58, 138), rgb(163, 187, 255));&quot;&gt;• регистрация и вход&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(30, 58, 138), rgb(163, 187, 255));&quot;&gt;• хеширование паролей,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(30, 58, 138), rgb(163, 187, 255));&quot;&gt;• профиль и смена пароля&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(30, 58, 138), rgb(163, 187, 255));&quot;&gt;• подписки и отписки&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(30, 58, 138), rgb(163, 187, 255));&quot;&gt;• счётчики подписчиков&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="330" x="725" y="40" as="geometry" />
        </mxCell>
        <mxCell id="content" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontSize=16;fontColor=#14532D;align=left;spacingLeft=16;arcSize=12;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(20, 83, 45), rgb(140, 194, 162));&quot;&gt;Сервис публикаций&lt;/b&gt;&lt;/div&gt;&lt;br&gt;• публикации и репосты&lt;br&gt;• черновики, теги, сортировка&lt;br&gt;• комментарии и лайки&lt;br&gt;• поиск по заголовку&lt;br&gt;• общая и персональная лента&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
